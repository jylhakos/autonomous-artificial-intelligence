# .env.example — copy to .env and fill in real values
# NEVER commit the real .env file to version control.

# ── Google ADK / Gemini ───────────────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key-here
ADK_MODEL=gemini-2.0-flash

# ── Google Cloud (required only for VertexAiMemoryBankService) ────────────────
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# AGENT_ENGINE_ID=your-agent-engine-id

# ── Microsoft Azure AI Foundry ────────────────────────────────────────────────
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>
MEMORY_STORE_CHAT_MODEL_DEPLOYMENT_NAME=gpt-4o
MEMORY_STORE_EMBEDDING_MODEL_DEPLOYMENT_NAME=text-embedding-3-small
FOUNDRY_AGENT_MODEL=gpt-4o
